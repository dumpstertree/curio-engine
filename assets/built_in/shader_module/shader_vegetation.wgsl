//==============================================================================
//
// Curio Engine
// Ghibli Vegetation Shader
//
// Part 4 - Fragment Shader
//
//==============================================================================

@fragment
fn fs_main(
    in : VSOut
) -> @location(0) vec4<f32> {

    //----------------------------------------------------------------------
    // Surface
    //----------------------------------------------------------------------

    let N =
        normalize(in.world_normal);

    let V =
        normalize(
            camera.view_pos.xyz
            - in.world_position
        );

    //----------------------------------------------------------------------
    // Shadow
    //----------------------------------------------------------------------

    let shadow =
        compute_shadow_factor(
            in.shadow_position
        );

    //----------------------------------------------------------------------
    // Lighting
    //----------------------------------------------------------------------

    let lighting =
        compute_vegetation_lighting(

            N,

            V,

            in.world_position,

            shadow,

            in.wind_weight
        );

    //----------------------------------------------------------------------
    // Base Color
    //----------------------------------------------------------------------

    var color =
        vegetation.base_color.rgb;

    //----------------------------------------------------------------------
    // World-space Color Variation
    //
    // Large, soft patches of color.
    //----------------------------------------------------------------------

    color *=
        color_variation(
            in.world_position
        );

    //----------------------------------------------------------------------
    // Height Gradient
    //
    // Brighter tips.
    //----------------------------------------------------------------------

    let tip =
        saturate(
            remap(
                in.local_height,
                0.0,
                1.0,
                0.0,
                1.0
            )
        );

    color *=
        mix(
            0.92,
            1.10,
            tip
        );

    //----------------------------------------------------------------------
    // Ambient Occlusion
    //
    // Blue vertex color.
    //----------------------------------------------------------------------

    color *=
        mix(
            0.75,
            1.0,
            in.ao
        );

    //----------------------------------------------------------------------
    // Very Soft Hue Shift
    //
    // Makes fields feel alive.
    //----------------------------------------------------------------------

    let hueNoise =
        world_variation(
            in.world_position
        );

    color.r *=
        1.0 + hueNoise * 0.015;

    color.g *=
        1.0 + hueNoise * 0.010;

    color.b *=
        1.0 - hueNoise * 0.010;

    //----------------------------------------------------------------------
    // Final Lighting
    //----------------------------------------------------------------------

    color *= lighting;

    //----------------------------------------------------------------------
    // Tiny Contrast Compression
    //
    // Gives the painterly look.
    //----------------------------------------------------------------------

    color =
        pow(
            color,
            vec3<f32>(0.92)
        );

    //----------------------------------------------------------------------
    // Clamp
    //----------------------------------------------------------------------

    color =
        clamp(
            color,
            vec3<f32>(0.0),
            vec3<f32>(1.0)
        );

    return vec4<f32>(
        color,
        1.0
    );
}